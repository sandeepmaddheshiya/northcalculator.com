{
  "name": "northcalculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-rates.mjs && next build && node scripts/postbuild.mjs",
    "rates": "node scripts/fetch-rates.mjs",
    "start": "npx --yes serve@14.2.4 out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:content": "vitest run src/calculators/content-gate.test.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:links": "node scripts/check-links.mjs",
    "new:calculator": "node scripts/new-calculator.mjs",
    "i18n:status": "node scripts/i18n-status.mjs",
    "check:stale": "node scripts/check-stale.mjs",
    "lhci": "lhci autorun",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:i18n",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
